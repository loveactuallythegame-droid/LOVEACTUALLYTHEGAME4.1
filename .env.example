# Database Configuration
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/love_actually_game?schema=public"

# AI Service Configuration
# OpenAI API key for Dr. Marcie's conversation analysis and response generation
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ElevenLabs API key for Dr. Marcie's voice synthesis
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"

# Authentication Configuration
# Secret key for JWT token signing (generate a random 32+ character string)
NEXTAUTH_SECRET="your-super-secret-nextauth-secret-key-here"

# Application URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# Dr. Marcie Voice Configuration
# ElevenLabs voice ID for Dr. Marcie (optional, will use default if not provided)
DR_MARCIE_VOICE_ID="your-elevenlabs-voice-id"

# Application Configuration
# Environment (development, staging, production)
NODE_ENV="development"

# Enable debug logging for development
DEBUG_MODE="true"

# Rate Limiting Configuration
# Requests per minute per IP (adjust for production)
RATE_LIMIT_RPM="100"

# File Upload Configuration
# Maximum file size for evidence uploads (in bytes)
MAX_FILE_SIZE="10485760"  # 10MB

# Allowed file types for uploads
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,video/mp4,audio/mpeg"

# Security Configuration
# Enable HTTPS only in production
FORCE_HTTPS="false"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Analytics Configuration (Optional)
# Vercel Analytics ID
VERCEL_ANALYTICS_ID=""

# Google Analytics ID
GOOGLE_ANALYTICS_ID=""

# PostHog Analytics Key
POSTHOG_KEY=""

# Email Configuration (Optional)
# For sending notifications and reports
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@loveactuallygame.com"

# Redis Configuration (Optional)
# For session storage and caching
REDIS_URL="redis://localhost:6379"

# Sentry Configuration (Optional)
# For error tracking and monitoring
SENTRY_DSN=""

# Stripe Configuration (Optional)
# For premium features and subscriptions
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Feature Flags
# Enable/disable specific features
ENABLE_VOICE_SYNTHESIS="true"
ENABLE_COMPETITION_MODE="true"
ENABLE_EVIDENCE_UPLOAD="true"
ENABLE_DAILY_METRICS="true"
ENABLE_SOS_FIGHT_SOLVER="true"
ENABLE_ROMANCE_REDEMPTION="true"
ENABLE_ADVANCED_ANALYTICS="true"

# Development Configuration
# Prisma Studio port
PRISMA_STUDIO_PORT="5555"

# Webhook URLs (Optional)
# For integrations with external services
WEBHOOK_URL_ACTIVITY_COMPLETED=""
WEBHOOK_URL_CONFLICT_RESOLVED=""
WEBHOOK_URL_MILESTONE_REACHED=""

# Content Moderation (Optional)
# OpenAI Moderation API for content filtering
ENABLE_CONTENT_MODERATION="true"

# Backup Configuration (Optional)
# AWS S3 for database backups
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"

# Monitoring Configuration (Optional)
# Health check endpoints
HEALTH_CHECK_TOKEN="your-health-check-secret"

# API Versioning
API_VERSION="v1"

# Timezone Configuration
DEFAULT_TIMEZONE="UTC"

# Localization
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES="en,es,fr,de"

# Performance Configuration
# Cache TTL in seconds
CACHE_TTL="3600"

# Database Connection Pool
DB_CONNECTION_LIMIT="10"

# Admin Configuration
# Admin panel access
ADMIN_EMAIL="admin@loveactuallygame.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Maintenance Mode
MAINTENANCE_MODE="false"
MAINTENANCE_MESSAGE="We're currently performing scheduled maintenance. Please check back soon!"

# Legal Configuration
PRIVACY_POLICY_URL="https://loveactuallygame.com/privacy"
TERMS_OF_SERVICE_URL="https://loveactuallygame.com/terms"
CONTACT_EMAIL="support@loveactuallygame.com"

# Social Media Integration (Optional)
FACEBOOK_APP_ID=""
TWITTER_API_KEY=""
INSTAGRAM_ACCESS_TOKEN=""

# Third-party Integrations (Optional)
ZOOM_API_KEY=""
CALENDLY_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Development Tools
# Enable React DevTools in production (set to false for production)
REACT_DEVTOOLS="true"

# Enable Redux DevTools
REDUX_DEVTOOLS="true"

# Custom Environment Variables
# Add any custom variables your deployment needs
CUSTOM_FEATURE_FLAG=""
CUSTOM_API_ENDPOINT=""
CUSTOM_CONFIG_VALUE=""