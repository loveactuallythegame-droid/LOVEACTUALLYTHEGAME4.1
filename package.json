  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Meli2112/love-actually-game.git"
  },
  "keywords": [
    "couples-therapy",
    "relationship-games",
    "ai-therapist",
    "interactive-therapy",
    "gaming-platform",
    "nextjs",
    "typescript",
    "react",
    "prisma",
    "tailwindcss"
